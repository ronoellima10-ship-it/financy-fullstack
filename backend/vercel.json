{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/graphql.ts": {
      "includeFiles": [
        "../node_modules/.prisma/client/**",
        "../node_modules/@prisma/client/**"
      ]
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/graphql" },
    { "source": "/graphql", "destination": "/api/graphql" }
  ]
}
